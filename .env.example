# PayPerPrompt public demo configuration
#
# Copy this file to .env.local and enter PUBLIC Base Sepolia addresses only:
#   cp .env.example .env.local
#
# Never put a private key, seed phrase, wallet password, or production secret
# in this file. Browser-wallet signing remains inside MetaMask, Coinbase
# Wallet, or Rabby.

# Disposable Base Sepolia account allowed to approve browser-wallet payments.
PAYER_ADDRESS=0xYOUR_DISPOSABLE_BASE_SEPOLIA_PAYER

# A different public Base Sepolia address that receives the test USDC.
MERCHANT_ADDRESS=0xYOUR_DISTINCT_BASE_SEPOLIA_MERCHANT

# Durable payer policy.
MAX_PER_CALL_USD=0.05
DAILY_LIMIT_USD=2.00

# Official x402 lane.
X402_NETWORK=eip155:84532
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_EXPECTED_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_FACILITATOR_URL=https://x402.org/facilitator
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Local services.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
CLOUDFLARED_BIN=/tmp/cloudflared
